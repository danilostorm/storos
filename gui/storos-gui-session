#!/usr/bin/env bash
set -euo pipefail
export MOZ_ENABLE_WAYLAND=0
export XDG_CURRENT_DESKTOP=StorOS
export XDG_SESSION_DESKTOP=storos-gui
export NO_AT_BRIDGE=1
openbox --sm-disable >/dev/null 2>&1 &
for i in {1..30}; do
    curl --silent --fail --max-time 1 http://127.0.0.1:8765/api/status >/dev/null 2>&1 && break
    sleep 1
done
exec firefox --no-remote --kiosk --private-window http://127.0.0.1:8765/
